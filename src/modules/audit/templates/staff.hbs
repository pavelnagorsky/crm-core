{{#if (eq eventType "STAFF_CREATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> добавил сотрудника: {{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_UPDATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> изменил данные сотрудника:</p>
<ul>
  {{#each payload.changes}}
  <li>{{this.labelRu}}: <s>{{this.from}}</s> → {{this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "STAFF_DELETED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> удалил сотрудника: {{payload.name}}</p>
{{/if}}
