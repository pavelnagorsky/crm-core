{{#if (eq eventType "SERVICE_CREATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> добавил услугу: {{payload.title}}, {{payload.price}}, {{payload.durationMinutes}} мин.</p>
{{/if}}

{{#if (eq eventType "SERVICE_UPDATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> изменил услугу:</p>
<ul>
  {{#each payload.changes}}
  <li>{{this.labelRu}}: <s>{{this.from}}</s> → {{this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "SERVICE_DELETED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> удалил услугу: {{payload.title}}</p>
{{/if}}
