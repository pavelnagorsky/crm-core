{{#if (eq eventType "BOOKING_CREATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> создал бронирование: {{payload.serviceName}} с {{payload.staffName}}, {{payload.startTime}} — {{payload.endTime}}, {{payload.price}}</p>
{{/if}}

{{#if (eq eventType "BOOKING_UPDATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> изменил бронирование:</p>
<ul>
  {{#each payload.changes}}
  <li>{{this.labelRu}}: <s>{{this.from}}</s> → {{this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "BOOKING_CANCELLED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> отменил бронирование{{#if payload.reason}}: {{payload.reason}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "BOOKING_STATUS_CHANGED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> изменил статус бронирования: <s>{{bookingStatus payload.from}}</s> → {{bookingStatus payload.to}}</p>
{{/if}}

{{#if (eq eventType "BOOKING_DELETED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{roleName actorRole}})</span> удалил бронирование</p>
{{/if}}
