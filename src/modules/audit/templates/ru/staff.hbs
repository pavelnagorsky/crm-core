{{#if (eq eventType "STAFF_CREATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> добавил сотрудника: {{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_UPDATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> изменил данные сотрудника:</p>
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{formatValue this.field this.from}}</s> → {{formatValue this.field this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "STAFF_DELETED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> удалил сотрудника: {{payload.name}}</p>
{{/if}}
