{{#if (eq eventType "STAFF_CREATED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_UPDATED")}}
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{#if (eq this.field "status")}}{{t "staffStatus" this.from}}{{else}}{{formatValue this.field this.from}}{{/if}}</s> → {{#if (eq this.field "status")}}{{t "staffStatus" this.to}}{{else}}{{formatValue this.field this.to}}{{/if}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "STAFF_DELETED")}}
<p>{{payload.name}}</p>
{{/if}}
