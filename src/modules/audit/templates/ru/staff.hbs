{{#if (eq eventType "STAFF_CREATED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_UPDATED")}}
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{#if (eq this.field "status")}}{{t "staffStatus" this.from}}{{else}}{{formatValue this.field this.from}}{{/if}}</s> → {{#if (eq this.field "status")}}{{t "staffStatus" this.to}}{{else}}{{formatValue this.field this.to}}{{/if}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "STAFF_DELETED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_COMPENSATION_UPDATED")}}
<p>{{t "fields" "STAFF" "compensation"}}: {{t "fields" "STAFF" "effectiveFrom"}} {{payload.effectiveFrom}}, {{t "fields" "STAFF" "serviceCommissionPercent"}} {{payload.serviceCommissionPercent}}, {{t "fields" "STAFF" "productCommissionPercent"}} {{payload.productCommissionPercent}}, {{t "fields" "STAFF" "fixedSalaryAmount"}} {{payload.fixedSalaryAmount}}{{#if payload.fixedSalaryAmount}} {{payload.currency}}{{/if}}, {{t "fields" "STAFF" "hourlyRate"}} {{payload.hourlyRate}}{{#if payload.hourlyRate}} {{payload.currency}}{{/if}}, {{t "fields" "STAFF" "salaryMode"}} {{t "salaryMode" payload.salaryMode}}</p>
{{/if}}

{{#if (eq eventType "STAFF_EARNING_ADDED")}}
<p>{{t "earningType" payload.type}}: {{payload.amount}}{{#if payload.currency}} {{payload.currency}}{{/if}}{{#if payload.reason}} — {{payload.reason}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "STAFF_EARNING_REVERSED")}}
<p>{{payload.amount}}{{#if payload.currency}} {{payload.currency}}{{/if}}{{#if payload.bookingId}} ({{payload.bookingId}}){{/if}}</p>
{{/if}}

{{#if (eq eventType "STAFF_SHIFTS_UPDATED")}}
<p>Изменён рабочий график в диапазоне {{payload.startDate}} — {{payload.endDate}}</p>
{{#if (isArray payload.after)}}
{{#if payload.before}}<p>Было:</p><ul>{{#each payload.before}}<li>{{this.date}}: {{this.startTime}} — {{this.endTime}}</li>{{/each}}</ul>{{/if}}
{{#if payload.after}}<p>Стало:</p><ul>{{#each payload.after}}<li>{{this.date}}: {{this.startTime}} — {{this.endTime}}</li>{{/each}}</ul>{{else}}<p>Смены отсутствуют</p>{{/if}}
{{/if}}
{{/if}}

{{#if (eq eventType "STAFF_BLOCK_CREATED")}}
<p>{{formatDateTime payload.startDateTime}} — {{formatDateTime payload.endDateTime}}{{#if payload.title}} — {{payload.title}}{{/if}}{{#if payload.reason}} ({{payload.reason}}){{/if}}</p>
{{/if}}

{{#if (or (eq eventType "CALENDAR_BLOCK_CREATED") (eq eventType "CALENDAR_BLOCK_UPDATED") (eq eventType "CALENDAR_BLOCK_MOVED") (eq eventType "CALENDAR_BLOCK_DELETED"))}}
{{payload.title}}
{{#if payload.occurrenceDate}}<p>Повторение: {{payload.occurrenceDate}}</p>{{/if}}
<ul>{{#each payload.changes}}<li>{{t "fields" ../entityType this.field}}: <s>{{formatValue this.field this.from}}</s> → {{formatValue this.field this.to}}</li>{{/each}}</ul>
{{/if}}

