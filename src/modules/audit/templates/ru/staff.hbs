{{#if (eq eventType "STAFF_CREATED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_UPDATED")}}
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{#if (eq this.field "status")}}{{t "staffStatus" this.from}}{{else}}{{formatValue this.field this.from}}{{/if}}</s> → {{#if (eq this.field "status")}}{{t "staffStatus" this.to}}{{else}}{{formatValue this.field this.to}}{{/if}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "STAFF_DELETED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "STAFF_COMPENSATION_UPDATED")}}
<p>{{t "fields" "STAFF" "compensation"}}: {{payload.effectiveFrom}}, {{t "fields" "STAFF" "serviceCommissionPercent"}} {{payload.serviceCommissionPercent}}, {{t "fields" "STAFF" "fixedSalaryAmount"}} {{payload.fixedSalaryAmount}}</p>
{{/if}}

{{#if (eq eventType "STAFF_EARNING_ADDED")}}
<p>{{payload.type}}: {{payload.amount}}{{#if payload.reason}} — {{payload.reason}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "STAFF_EARNING_REVERSED")}}
<p>{{payload.amount}}{{#if payload.bookingId}} ({{payload.bookingId}}){{/if}}</p>
{{/if}}

