{{#if (eq eventType "PRICE_LEVEL_CREATED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "PRICE_LEVEL_UPDATED")}}
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{formatValue this.field this.from}}</s> → {{formatValue this.field this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "PRICE_LEVEL_DELETED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "LEVEL_PRICES_FILLED")}}
<p>{{payload.name}}: обновлено цен {{payload.updated}}</p>
{{/if}}
