{{#if (eq eventType "PRICE_RULE_CREATED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "PRICE_RULE_UPDATED")}}
<p>{{payload.name}}</p>
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{formatValue this.field this.from}}</s> → {{formatValue this.field this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "PRICE_RULE_ENABLED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "PRICE_RULE_DISABLED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "PRICE_RULE_ARCHIVED")}}
<p>{{payload.name}}</p>
{{/if}}

{{#if (eq eventType "PRICE_RULE_RESTORED")}}
<p>{{payload.name}}</p>
{{/if}}
