{{#if (eq eventType "PRODUCT_PRICE_CHANGE_CREATED")}}
<p>{{payload.title}} с {{formatValue "effectiveDate" payload.effectiveDate}}: товаров {{payload.productsCount}}</p>
{{/if}}

{{#if (eq eventType "PRODUCT_PRICES_IMPORTED")}}
<p>{{payload.fileName}}: изменено цен {{payload.itemsCount}}{{#if payload.effectiveDate}} с {{formatValue "effectiveDate" payload.effectiveDate}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "PRODUCT_PRICE_CHANGE_APPLIED")}}
<p>{{payload.title}}: изменено цен {{payload.appliedCount}}{{#if payload.applySkippedCount}}, пропущено {{payload.applySkippedCount}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "PRODUCT_PRICE_CHANGE_CANCELLED")}}
<p>{{payload.title}} с {{formatValue "effectiveDate" payload.effectiveDate}}</p>
{{/if}}

{{#if (eq eventType "PRODUCT_PRICE_CHANGE_ROLLED_BACK")}}
<p>{{payload.title}}: возвращено {{payload.restoredCount}}, не возвращено {{payload.rollbackSkippedCount}}</p>
{{/if}}
