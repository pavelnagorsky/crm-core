{{#if (eq eventType "PAYROLL_PERIOD_CREATED")}}
<p>{{t "fields" "PAYROLL" "startDate"}} {{payload.startDate}} — {{t "fields" "PAYROLL" "endDate"}} {{payload.endDate}}</p>
{{/if}}

{{#if (eq eventType "PAYROLL_PERIOD_DELETED")}}
<p>{{t "fields" "PAYROLL" "deleted"}}</p>
{{/if}}

{{#if (eq eventType "PAYROLL_CALCULATED")}}
<p>{{t "fields" "PAYROLL" "staffCount"}}: {{payload.staffCount}}</p>
{{/if}}

{{#if (eq eventType "PAYROLL_APPROVED")}}
<p>{{t "fields" "PAYROLL" "approved"}}</p>
{{/if}}

{{#if (eq eventType "PAYROLL_PAID")}}
<p>{{t "fields" "PAYROLL" "paid"}}</p>
{{/if}}

{{#if (eq eventType "PAYROLL_CORRECTED")}}
<p>{{#if payload.type}}{{t "earningType" payload.type}}{{else}}{{t "earningType" "CORRECTION"}}{{/if}}: {{payload.amount}}{{#if payload.currency}} {{payload.currency}}{{/if}}{{#if payload.reason}} — {{payload.reason}}{{/if}}</p>
{{/if}}
