{{#if (eq eventType "SERVICE_CREATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> добавил услугу: {{payload.title}}, {{payload.price}}, {{payload.durationMinutes}} мин.</p>
{{/if}}

{{#if (eq eventType "SERVICE_UPDATED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> изменил услугу:</p>
<ul>
  {{#each payload.changes}}
  <li>{{t "fields" ../entityType this.field}}: <s>{{formatValue this.field this.from}}</s> → {{formatValue this.field this.to}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if (eq eventType "SERVICE_DELETED")}}
<p><strong>{{actorName}}</strong> <span class="audit-role">({{t "actorRole" actorRole}})</span> удалил услугу: {{payload.title}}</p>
{{/if}}
