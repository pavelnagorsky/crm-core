{{#if (eq eventType "BOOKING_CREATED")}}
<p>{{payload.serviceName}} с {{payload.staffName}}, {{formatDateTime payload.startTime}} — {{formatDateTime payload.endTime}}, {{payload.price}}</p>
{{/if}}

{{#if (eq eventType "BOOKING_CANCELLED")}}
<p>{{t "cancelledBy" payload.cancelledBy}}{{#if payload.reason}}: {{payload.reason}}{{/if}}</p>
{{/if}}

{{#if (eq eventType "BOOKING_STATUS_CHANGED")}}
<p><s>{{t "bookingStatus" payload.from}}</s> → {{t "bookingStatus" payload.to}}</p>
{{/if}}
