<tr>
  <td class="label" width="112" valign="top" style="width: 112px; padding: 4px 16px 4px 0; font-size: 14px; line-height: 22px; color: #637381;">{{label}}</td>
  <td valign="top" style="padding: 4px 0; font-size: 14px; line-height: 22px; font-weight: 600; color: #1C252E;{{#if multiline}} white-space: pre-wrap; word-break: break-word;{{/if}}">{{#if href}}<a href="{{href}}" style="color: #007867; text-decoration: underline;">{{value}}</a>{{else}}{{value}}{{/if}}</td>
</tr>
