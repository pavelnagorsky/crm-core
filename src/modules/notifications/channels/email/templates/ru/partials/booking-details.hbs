<div class="details">
  <div class="details-title">{{t "email" "common" "details"}}</div>
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "service"}}</span>
    <span class="details-value">{{serviceTitle}}</span>
  </div>
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "specialist"}}</span>
    <span class="details-value">{{staffName}}</span>
  </div>
  {{#if previousStartAt}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "previousTime"}}</span>
    <span class="details-value"><s>{{formatVisit previousStartAt}}</s></span>
  </div>
  {{/if}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "dateTime"}}</span>
    <span class="details-value">{{formatVisit startAt}} — {{formatTime endAt}}</span>
  </div>
  {{#if locationAddress}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "address"}}</span>
    <span class="details-value">{{locationAddress}}</span>
  </div>
  {{/if}}
  {{#if locationPhone}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "phone"}}</span>
    <span class="details-value"><a href="tel:{{locationPhone}}">{{locationPhone}}</a></span>
  </div>
  {{/if}}
  {{#if cancellationReason}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "reason"}}</span>
    <span class="details-value">{{cancellationReason}}</span>
  </div>
  {{/if}}
</div>
