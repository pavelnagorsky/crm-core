<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: {{#if last}}0{{else}}0 0 20px{{/if}};">
  <tr>
    <td align="center" bgcolor="{{@root.buttonColor}}" style="border-radius: 8px; background: {{@root.buttonColor}};">
      <a href="{{#if tel}}tel:{{tel}}{{else}}{{href}}{{/if}}" target="_blank" style="display: inline-block; padding: 12px 24px; font-size: 15px; line-height: 24px; font-weight: 700; color: #FFFFFF; text-decoration: none; border-radius: 8px;">{{label}}</a>
    </td>
  </tr>
</table>
