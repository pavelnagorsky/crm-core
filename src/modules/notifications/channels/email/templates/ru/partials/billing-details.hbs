<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px;">
  <tr>
    <td class="panel" bgcolor="#F4F6F8" style="background: #F4F6F8; border-radius: 12px; padding: 16px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{> billingRow label=(t "email" "billing" "brand") value=brandName}}
        {{#if ownerEmail}}{{> billingRow label=(t "email" "billing" "owner") value=ownerEmail}}{{/if}}
        {{#if paymentNumber}}{{> billingRow label=(t "email" "billing" "payment") value=paymentNumber}}{{/if}}
        {{#if planName}}{{#if suggestedPlan}}{{> billingRow label=(t "email" "billing" "suggestedPlan") value=planName}}{{else}}{{> billingRow label=(t "email" "billing" "plan") value=planName}}{{/if}}{{/if}}
        {{#if billingPeriod}}{{> billingRow label=(t "email" "billing" "period") value=(t "email" "billing" "periods" billingPeriod)}}{{/if}}
        {{#if amount}}{{> billingRow label=(t "email" "billing" "amount") value=amount}}{{/if}}
        {{#if expiresAt}}{{> billingRow label=(t "email" "billing" "expires") value=(formatDayMonth expiresAt)}}{{/if}}
        {{#if lastDay}}{{> billingRow label=(t "email" "billing" "accessUntil") value=(formatDayMonth lastDay)}}{{/if}}
        {{#if graceLastDay}}{{> billingRow label=(t "email" "billing" "graceUntil") value=(formatDayMonth graceLastDay)}}{{/if}}
        {{#if comment}}{{> billingRow label=(t "email" "billing" "comment") value=comment}}{{/if}}
      </table>
    </td>
  </tr>
</table>
