<p>{{#if recipientFirstName}}Здравствуйте, <strong>{{recipientFirstName}}</strong>!{{else}}Здравствуйте!{{/if}} {{t "email" "staff-booking-event" variant "body"}}</p>
<div class="details">
  <div class="details-title">{{t "email" "common" "details"}}</div>
  <div class="details-row">
    <span class="details-label">{{t "email" "staff-booking-event" "client"}}</span>
    <span class="details-value">{{clientName}}</span>
  </div>
  {{#if clientPhone}}
  <div class="details-row">
    <span class="details-label">{{t "email" "staff-booking-event" "phone"}}</span>
    <span class="details-value">{{clientPhone}}</span>
  </div>
  {{/if}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "service"}}</span>
    <span class="details-value">{{serviceTitle}}</span>
  </div>
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "specialist"}}</span>
    <span class="details-value">{{staffName}}</span>
  </div>
  {{#if previousStartAt}}
  <div class="details-row">
    <span class="details-label">{{t "email" "staff-booking-event" "previousTime"}}</span>
    <span class="details-value"><s>{{formatVisit previousStartAt}}</s></span>
  </div>
  {{/if}}
  <div class="details-row">
    <span class="details-label">{{t "email" "common" "dateTime"}}</span>
    <span class="details-value">{{formatVisit startAt}} — {{formatTime endAt}}</span>
  </div>
  {{#if cancellationReason}}
  <div class="details-row">
    <span class="details-label">{{t "email" "staff-booking-event" "reason"}}</span>
    <span class="details-value">{{cancellationReason}}</span>
  </div>
  {{/if}}
</div>
<a class="btn" href="{{bookingUrl}}">{{t "email" "staff-booking-event" "action"}}</a>
<p class="hint">{{t "email" "staff-booking-event" "hint"}}</p>
