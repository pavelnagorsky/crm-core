{{> greeting name=clientFirstName body=(tv "body")}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px;">
  <tr>
    <td class="panel" align="center" bgcolor="#F4F6F8" style="background: #F4F6F8; border-radius: 12px; padding: 24px; text-align: center;">
      <div style="font-size: 15px; line-height: 22px; font-weight: 600; color: #1C252E;">{{serviceTitle}} · {{staffName}}</div>
      <div style="margin: 10px 0 0; font-size: 13px; line-height: 20px; color: #637381;">{{capitalize (formatVisitDay startAt)}}</div>
      <div style="margin: 14px 0 0; padding-left: 12px; font-size: 36px; line-height: 40px; letter-spacing: 12px;"><a href="{{manageLink}}" target="_blank" style="color: #FFAB00; text-decoration: none;">&#9734;&#9734;&#9734;&#9734;&#9734;</a></div>
    </td>
  </tr>
</table>
{{> button href=manageLink label=(tv "action")}}
<p style="margin: 0; font-size: 14px; line-height: 22px; color: #637381;">{{tv "hint"}}</p>
{{> linkFallback href=manageLink}}
