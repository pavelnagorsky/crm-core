  <tr>
    <td class="panel" align="center" bgcolor="#F4F6F8" style="background: #F4F6F8; border-radius: 12px; padding: 24px; text-align: center;">
      <div style="padding-left: 10px; font-size: 40px; line-height: 48px; font-weight: 700; letter-spacing: 10px; color: #1C252E; font-family: 'SF Mono', Menlo, Consolas, 'Courier New', monospace;">{{code}}</div>
      <div style="margin: 6px 0 0; font-size: 13px; line-height: 20px; color: #637381;">{{t "email" "reset-password" "ttl"}}</div>
    </td>
  </tr>
</table>
<p style="margin: 0; font-size: 14px; line-height: 22px; color: #637381;">{{t "email" "reset-password" "hint"}}</p>
