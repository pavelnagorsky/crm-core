<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}}</title>
  <style>
    body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #18181b; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .header { background: #18181b; padding: 28px 40px; }
    .header h1 { margin: 0; font-size: 20px; font-weight: 600; color: #ffffff; letter-spacing: -0.3px; }
    .body { padding: 36px 40px; }
    .body p { margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #3f3f46; }
    .details { background: #f4f4f5; border-radius: 6px; padding: 16px 20px; margin: 0 0 24px; }
    .details-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: #71717a; margin: 0 0 12px; }
    .details-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; }
    .details-row:last-child { margin-bottom: 0; }
    .details-label { color: #71717a; }
    .details-value { color: #18181b; font-weight: 500; text-align: right; max-width: 60%; }
    .btn { display: block; width: fit-content; background: #18181b; color: #ffffff !important; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-size: 14px; font-weight: 600; margin: 0 0 24px; }
    .hint { font-size: 13px; color: #71717a; margin: 0 0 16px; }
    .link-fallback { font-size: 12px; color: #71717a; word-break: break-all; }
    .link-fallback a { color: #71717a; }
    .footer { border-top: 1px solid #f4f4f5; padding: 20px 40px; font-size: 12px; color: #a1a1aa; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header"><h1>{{subject}}</h1></div>
    <div class="body">
      {{{content}}}
    </div>
    <div class="footer">{{t "email" "common" "footer"}}</div>
  </div>
</body>
</html>
