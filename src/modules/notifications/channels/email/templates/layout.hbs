<!DOCTYPE html>
<html lang="{{lang}}" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>{{subject}}</title>
  <style>
    body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    @media only screen and (max-width: 620px) {
      .outer { padding: 16px 8px !important; }
      .card { padding: 28px 20px 32px !important; border-radius: 12px !important; }
      .heading { font-size: 26px !important; line-height: 32px !important; }
      .panel { padding: 16px !important; }
      .label { width: 96px !important; }
      .footer { padding: 20px 12px 0 !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background: #F4F6F8;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F4F6F8" style="background: #F4F6F8;">
    <tr>
      <td class="outer" align="center" style="padding: 40px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px;">
          <tr>
            <td class="card" bgcolor="#FFFFFF" style="background: #FFFFFF; border: 1px solid #E8EDEF; border-radius: 16px; padding: 36px 40px 40px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #1C252E; text-align: left;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  {{#if logoUrl}}
                  <td style="padding-right: 12px; vertical-align: middle;">
                    <img src="{{logoUrl}}" alt="{{senderName}}" height="40" style="display: block; height: 40px; width: auto; max-width: 160px; border: 0; border-radius: 10px;" />
                  </td>
                  {{else}}
                  <td style="padding-right: 12px; vertical-align: middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="40" height="40" align="center" valign="middle" bgcolor="#1C252E" style="width: 40px; height: 40px; border-radius: 10px; background: #1C252E; color: #FFFFFF; font-size: 19px; line-height: 40px; font-weight: 700; text-align: center;">{{senderInitial}}</td>
                      </tr>
                    </table>
                  </td>
                  {{/if}}
                  <td style="vertical-align: middle; font-size: 17px; line-height: 24px; font-weight: 700; color: #1C252E;">{{senderName}}</td>
                </tr>
              </table>
              <div style="height: 1px; line-height: 1px; font-size: 0; background: #E8EDEF; margin: 24px 0 28px;">&nbsp;</div>
              {{#if chip}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 14px;">
                <tr>
                  <td bgcolor="{{chip.background}}" style="background: {{chip.background}}; border-radius: 999px; padding: 3px 12px 3px 10px; height: 20px; font-size: 12px; line-height: 20px; font-weight: 600; color: {{chip.color}}; white-space: nowrap;"><span style="font-size: 9px; line-height: 20px; vertical-align: top;">&#9679;</span>&nbsp;&nbsp;{{chip.label}}</td>
                </tr>
              </table>
              {{/if}}
              <h1 class="heading" style="margin: 0 0 12px; font-size: 30px; line-height: 36px; font-weight: 800; letter-spacing: -0.3px; color: #1C252E;">{{heading}}</h1>
              {{{content}}}
            </td>
          </tr>
          <tr>
            <td class="footer" align="center" style="padding: 24px 40px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 12px; line-height: 18px; color: #919EAB; text-align: center;">
              {{#if footerLinks}}
              <div style="margin: 0 0 12px; font-size: 13px; line-height: 22px;">
                <a href="{{footerLinks.faqs}}" target="_blank" style="color: #637381; text-decoration: underline; white-space: nowrap;">{{t "email" "common" "footerLinks" "faqs"}}</a>&nbsp;&nbsp;·&nbsp; <a href="{{footerLinks.contacts}}" target="_blank" style="color: #637381; text-decoration: underline; white-space: nowrap;">{{t "email" "common" "footerLinks" "contacts"}}</a>&nbsp;&nbsp;·&nbsp; <a href="{{footerLinks.privacyPolicy}}" target="_blank" style="color: #637381; text-decoration: underline; white-space: nowrap;">{{t "email" "common" "footerLinks" "privacyPolicy"}}</a>&nbsp;&nbsp;·&nbsp; <a href="{{footerLinks.termsOfService}}" target="_blank" style="color: #637381; text-decoration: underline; white-space: nowrap;">{{t "email" "common" "footerLinks" "termsOfService"}}</a>
              </div>
              {{/if}}
              {{#if footerContact}}<div>{{footerContact}}</div>{{/if}}
              <div>{{#if footerNote}}{{footerNote}}{{else}}{{t "email" "common" "footer"}}{{/if}}</div>
              <div>{{#if platformTagline}}<a href="{{siteUrl}}" target="_blank" style="color: #637381; font-weight: 600; text-decoration: underline;">Klendo</a> - {{t "email" "common" "platformTagline"}}{{else}}{{t "email" "common" "poweredBy"}} <a href="{{siteUrl}}" target="_blank" style="color: #637381; font-weight: 600; text-decoration: underline;">Klendo</a>{{/if}}</div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
