<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}}</title>
  <style>
    body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #18181b; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .header { background: #ffffff; padding: 28px 40px; border-bottom: 1px solid #f4f4f5; }
    .brand-name { font-size: 24px; font-weight: 700; color: #18181b; letter-spacing: -0.3px; word-break: break-word; }
    .brand-logo { display: block; height: 48px; width: auto; max-width: 160px; border: 0; }
    .body { padding: 36px 40px; }
    .body h1 { margin: 0 0 24px; font-size: 22px; line-height: 1.3; font-weight: 600; color: #18181b; }
    .body p { margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #3f3f46; }
    .details { background: #f4f4f5; border-radius: 6px; padding: 16px 20px; margin: 0 0 24px; }
    .details-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: #71717a; margin: 0 0 12px; }
    .details-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; }
    .details-row:last-child { margin-bottom: 0; }
    .details-label { color: #71717a; }
    .details-value { color: #18181b; font-weight: 500; text-align: right; max-width: 60%; }
    .btn { display: block; width: fit-content; background: #18181b; color: #ffffff !important; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-size: 14px; font-weight: 600; margin: 0 0 24px; }
    .platform .btn { background: #00a76f; }
    .body .code { font-size: 32px; font-weight: 700; letter-spacing: 6px; color: #18181b; }
    .hint { font-size: 13px; color: #71717a; margin: 0 0 16px; }
    .link-fallback { font-size: 12px; color: #71717a; word-break: break-all; }
    .link-fallback a { color: #71717a; }
    .footer { border-top: 1px solid #f4f4f5; padding: 20px 40px; font-size: 12px; color: #a1a1aa; }
    .powered-by { margin-top: 12px; font-size: 11px; color: #a1a1aa; }
    @media only screen and (max-width: 600px) {
      .wrapper { margin: 16px auto; }
      .header, .body, .footer { padding: 24px; }
    }
  </style>
</head>
<body>
  <div class="wrapper {{brandingClass}}">
    <div class="header">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          {{#if logoUrl}}
          <td style="padding-right: 14px; vertical-align: middle;">
            <img class="brand-logo" src="{{logoUrl}}" alt="{{senderName}}" height="48" style="display: block; height: 48px; width: auto; max-width: 160px; border: 0;" />
          </td>
          {{/if}}
          <td class="brand-name" style="vertical-align: middle;">{{senderName}}</td>
        </tr>
      </table>
    </div>
    <div class="body">
      <h1>{{heading}}</h1>
      {{{content}}}
    </div>
    <div class="footer">
      {{t "email" "common" "footer"}}
      {{#unless isPlatform}}<div class="powered-by">Powered by Klendo</div>{{/unless}}
    </div>
  </div>
</body>
</html>
