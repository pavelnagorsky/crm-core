generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum BusinessRole {
  OWNER
  STAFF
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CalendarEventType {
  BLOCK
  BOOKING
  INTEGRATION
}

enum CalendarEventRepeatType {
  NONE
  WEEKLY
}

enum BookingVisibility {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CancelledBy {
  CLIENT
  STAFF
}

enum BookingSource {
  PUBLIC_PAGE
  WIDGET
  MANUAL
}

enum BookingExecutionMode {
  SEQUENTIAL
  PARALLEL
}

enum BundlePricingMode {
  SUM
  FIXED
}

enum BookingChannelStatus {
  DRAFT
  PUBLISHED
}

enum BookingPalette {
  INK
  SAND
  SAGE
  DUSK
  WINE
  PEARL
  GRAPHITE
  EMERALD
  SKY
  LAVENDER
  CORAL
  MONO
  CUSTOM
}

enum BookingWidgetPlacement {
  INLINE
  SIDEBAR
  DIALOG
}

enum BookingWidgetTrigger {
  INLINE_BUTTON
  FLOATING_BUTTON
}

enum BookingWidgetButtonPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum AuditEntity {
  BOOKING
  CLIENT
  STAFF
  SERVICE
  BUSINESS
  PAYROLL
}

enum AuditEvent {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_DEACTIVATED
  STAFF_DELETED
  STAFF_COMPENSATION_UPDATED
  STAFF_EARNING_ADDED
  STAFF_EARNING_REVERSED
  STAFF_SHIFTS_UPDATED
  STAFF_BLOCK_CREATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED
  BUSINESS_UPDATED
  PAYROLL_PERIOD_CREATED
  PAYROLL_PERIOD_DELETED
  PAYROLL_CALCULATED
  PAYROLL_APPROVED
  PAYROLL_PAID
  PAYROLL_CORRECTED
}

enum AuditActorRole {
  CLIENT
  STAFF
  OWNER
  SUPPORT
  SYSTEM
  INTEGRATION
}

enum AuditActionType {
  CREATE
  MODIFY
  DELETE
  ACTION
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum StaffEarningType {
  SERVICE_COMMISSION
  PRODUCT_COMMISSION
  HOURLY
  FIXED_SALARY
  BONUS
  DEDUCTION
  CORRECTION
}

enum StaffEarningSource {
  BOOKING
  SHIFT
  PRODUCT_SALE
  MANUAL
  PAYROLL
  IMPORT
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum StaffEmploymentType {
  LABOR_CONTRACT
  CIVIL_CONTRACT
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
}

enum StaffPayoutMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum CompensationSalaryMode {
  ADDITIVE
  GUARANTEED_MINIMUM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                       String         @id @default(uuid())
  role                     UserRole       @default(USER)
  firstName                String?        @db.VarChar(100)
  lastName                 String?        @db.VarChar(100)
  phone                    String?        @unique @db.VarChar(30)
  email                    String?        @unique @db.VarChar(254)
  passwordHash             String?
  phoneVerifiedAt          DateTime?
  emailVerifiedAt          DateTime?
  isMarketingEmailsEnabled Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  refreshTokens            RefreshToken[]
  passwordResetCode        PasswordResetCode?
  memberships              Membership[]
  clients                  Client[]
  staffProfiles            Staff[]
  files                    File[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique @db.VarChar(512)
  userAgent  String?  @db.VarChar(512)
  expiryDate DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  codeHash  String   @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                            String              @id @default(uuid())
  name                          String              @db.VarChar(255)
  logoFileId                    String?
  advanceBookingWindowDays      Int                 @default(15)
  slotIntervalMinutes           Int                 @default(30)
  minimumBookingNoticeMinutes   Int                 @default(0)
  timezone                      String              @default("UTC") @db.VarChar(64)
  currency                      String              @default("USD") @db.VarChar(3)
  bookingVisibility             BookingVisibility   @default(PUBLIC)
  isBookingConfirmationRequired Boolean             @default(false)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  logoFile                      File?               @relation(fields: [logoFileId], references: [id], onDelete: SetNull)
  memberships                   Membership[]
  clients                       Client[]
  serviceCategories             ServiceCategory[]
  services                      Service[]
  staff                         Staff[]
  staffInvitations              StaffInvitation[]
  calendarEvents                CalendarEvent[]
  bookings                      Booking[]
  compensationPlans             StaffCompensationPlan[]
  staffEarnings                 StaffEarning[]
  payrollPeriods                PayrollPeriod[]
  payrollResults                PayrollResult[]
  bookingPages                  BookingPage[]
  bookingWidgets                BookingWidget[]
  serviceBundles                ServiceBundle[]
  bookingItems                  BookingItem[]
}

model Membership {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model Client {
  id         String   @id @default(uuid())
  businessId String
  userId     String?

  firstName  String    @db.VarChar(100)
  lastName   String    @db.VarChar(100)
  phone      String    @db.VarChar(30)
  email      String?   @db.VarChar(254)
  birthDate  DateTime? @db.Date
  gender     String?   @db.VarChar(20)
  notes      String?   @db.VarChar(1000)
  bannedAt   DateTime?
  banReason  String?   @db.VarChar(500)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings   Booking[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([userId])
}

model ServiceCategory {
  id          String   @id @default(uuid())
  businessId  String
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]
  bundles    ServiceBundle[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Service {
  id              String   @id @default(uuid())
  businessId      String
  categoryId      String?
  imageFileId     String?
  title           String   @db.VarChar(150)
  description     String?  @db.VarChar(2000)
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  status          ServiceStatus @default(ACTIVE)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business         Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         ServiceCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFile        File?                         @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  staffServices    StaffService[]
  bookingItems     BookingItem[]
  bundleItems      ServiceBundleItem[]
  commissionRates  StaffCompensationServiceRate[]

  @@index([businessId])
  @@index([categoryId])
}

model ServiceBundle {
  id            String               @id @default(uuid())
  businessId    String
  categoryId    String?
  imageFileId   String?
  title         String               @db.VarChar(150)
  description   String?              @db.VarChar(2000)
  executionMode BookingExecutionMode @default(SEQUENTIAL)
  pricingMode   BundlePricingMode    @default(SUM)
  fixedPrice    Decimal?             @db.Decimal(10, 2)
  status        ServiceStatus        @default(ACTIVE)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  ServiceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFile File?               @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  items     ServiceBundleItem[]
  bookings  Booking[]

  @@index([businessId])
  @@index([categoryId])
}

model ServiceBundleItem {
  id        String @id @default(uuid())
  bundleId  String
  serviceId String
  sortOrder Int    @default(0)

  bundle  ServiceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bundleId, serviceId])
  @@index([bundleId])
  @@index([serviceId])
}

model Staff {
  id           String   @id @default(uuid())
  businessId   String
  userId       String?
  avatarFileId String?
  name         String   @db.VarChar(250)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(254)
  roleTitle        String?              @db.VarChar(250)
  description      String?              @db.VarChar(2000)
  status           StaffStatus          @default(ACTIVE)
  employmentType   StaffEmploymentType?
  taxId            String?              @db.VarChar(20)
  employeeNumber   String?              @db.VarChar(30)
  payoutMethod     StaffPayoutMethod?
  payoutNote       String?              @db.VarChar(250)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  avatarFile    File?             @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  staffServices StaffService[]
  invitations   StaffInvitation[]
  shifts        StaffShift[]
  calendarEvents CalendarEvent[]
  bookingItems  BookingItem[]
  compensationPlans StaffCompensationPlan[]
  earnings          StaffEarning[]
  payrollResults    PayrollResult[]

  @@index([businessId])
}

model File {
  id            String   @id @default(uuid())
  userId        String
  url           String   @db.VarChar(1000)
  storageKey    String   @db.VarChar(500)
  fileName      String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffAvatars      Staff[]
  businessLogos     Business[]
  serviceImages     Service[]
  serviceBundleImages ServiceBundle[]
  bookingPageCovers BookingPage[]

  @@index([userId])
}

model StaffInvitation {
  id         String                @id @default(uuid())
  staffId    String
  businessId String
  tokenHash  String                @unique @db.VarChar(255)
  status     StaffInvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([businessId])
  @@index([status])
  @@index([expiresAt])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffShift {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  earnings  StaffEarning[]

  @@unique([staffId, date])
  @@index([staffId, date])
}

model CalendarEvent {
  id            String                  @id @default(uuid())
  businessId    String
  staffId       String?
  type          CalendarEventType       @default(BLOCK)
  reason        String?                 @db.VarChar(100)
  title         String?                 @db.VarChar(255)
  notes         String?                 @db.VarChar(1000)
  repeatType    CalendarEventRepeatType @default(NONE)
  startDateTime DateTime
  endDateTime   DateTime
  daysMask      String?                 @db.VarChar(7)
  repeatUntil   DateTime?               @db.Date
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  business             Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff                Staff?                           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cancelledOccurrences CalendarEventCancelledOccurrence[]
  bookingItem          BookingItem?

  @@index([businessId])
  @@index([businessId, staffId])
  @@index([businessId, repeatType, startDateTime])
}

model CalendarEventCancelledOccurrence {
  id             String        @id @default(uuid())
  eventId        String
  occurrenceDate DateTime      @db.Date
  createdAt      DateTime      @default(now())

  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
}

model Booking {
  id         String @id @default(uuid())

  businessId String
  clientId   String

  startAt    DateTime
  endAt      DateTime
  executionMode BookingExecutionMode @default(SEQUENTIAL)
  bundleId   String?

  status     BookingStatus @default(CONFIRMED)
  source     BookingSource

  bookingPageId   String?
  bookingWidgetId String?

  clientFirstName String  @db.VarChar(100)
  clientLastName  String  @db.VarChar(100)
  clientPhone     String  @db.VarChar(30)
  clientEmail     String? @db.VarChar(254)

  notes         String? @db.VarChar(1000)
  internalNotes String? @db.VarChar(2000)

  cancellationReason String?     @db.VarChar(1000)
  cancelledBy        CancelledBy?
  cancelledAt        DateTime?

  reminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business      Business       @relation(fields: [businessId],     references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId],        references: [id], onDelete: Restrict)
  bundle        ServiceBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  earnings      StaffEarning[]
  bookingPage   BookingPage?   @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  bookingWidget BookingWidget? @relation(fields: [bookingWidgetId], references: [id], onDelete: SetNull)

  @@index([businessId, deletedAt, startAt])
  @@index([clientId, deletedAt, startAt])
  @@index([status])
  @@index([bundleId])
  @@index([bookingPageId])
  @@index([bookingWidgetId])
}

model BookingItem {
  id              String   @id @default(uuid())
  bookingId       String
  businessId      String
  serviceId       String
  staffId         String
  sortOrder       Int      @default(0)
  startAt         DateTime
  endAt           DateTime
  serviceTitle    String   @db.VarChar(150)
  serviceDuration Int
  listPrice       Decimal  @db.Decimal(10, 2)
  chargedPrice    Decimal  @db.Decimal(10, 2)
  customPrice     Decimal? @db.Decimal(10, 2)
  staffName       String   @db.VarChar(250)
  calendarEventId String?  @unique

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  earnings      StaffEarning[]

  @@index([bookingId])
  @@index([businessId])
  @@index([staffId, startAt])
  @@index([serviceId])
}

model BookingPage {
  id              String               @id @default(uuid())
  businessId      String
  title           String               @db.VarChar(80)
  slug            String               @unique @db.VarChar(48)
  status          BookingChannelStatus @default(DRAFT)
  tagline         String               @default("") @db.VarChar(120)
  html            String               @default("") @db.VarChar(20000)
  metaTitle       String               @default("") @db.VarChar(70)
  metaDescription String               @default("") @db.VarChar(160)
  coverFileId     String?

  palette           BookingPalette
  customBackground  String?        @db.VarChar(7)
  customSurface     String?        @db.VarChar(7)
  customText        String?        @db.VarChar(7)
  customMuted       String?        @db.VarChar(7)
  customAccent      String?        @db.VarChar(7)
  customAccentText  String?        @db.VarChar(7)
  headline          String         @db.VarChar(80)
  caption           String         @default("") @db.VarChar(120)
  buttonLabel       String         @db.VarChar(32)
  showStaff         Boolean
  showServiceImages Boolean
  showBranding      Boolean

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  coverFile File?    @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([businessId, updatedAt])
}

model BookingWidget {
  id              String                     @id @default(uuid())
  businessId      String
  title           String                     @db.VarChar(80)
  titleKey        String                     @db.VarChar(80)
  status          BookingChannelStatus       @default(DRAFT)
  placement       BookingWidgetPlacement
  trigger         BookingWidgetTrigger
  buttonPosition  BookingWidgetButtonPosition
  allowedDomains  String[]                   @default([])

  palette           BookingPalette
  customBackground  String?        @db.VarChar(7)
  customSurface     String?        @db.VarChar(7)
  customText        String?        @db.VarChar(7)
  customMuted       String?        @db.VarChar(7)
  customAccent      String?        @db.VarChar(7)
  customAccentText  String?        @db.VarChar(7)
  headline          String         @db.VarChar(80)
  caption           String         @default("") @db.VarChar(120)
  buttonLabel       String         @db.VarChar(32)
  showStaff         Boolean
  showServiceImages Boolean
  showBranding      Boolean

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([businessId, titleKey])
  @@index([businessId, updatedAt])
}

model AuditLog {
  id         String          @id @default(uuid())
  businessId String
  entityType AuditEntity
  entityId   String
  eventType  AuditEvent
  actionType AuditActionType
  occurredAt DateTime
  actorId    String?
  actorName  String          @db.VarChar(300)
  actorRole  AuditActorRole
  payload    Json
  createdAt  DateTime        @default(now())

  @@index([businessId, entityType, entityId])
  @@index([businessId, entityType, entityId, createdAt])
}

model StaffCompensationPlan {
  id                       String                 @id @default(uuid())
  businessId               String
  staffId                  String
  effectiveFrom            DateTime               @db.Date
  effectiveTo              DateTime?              @db.Date
  fixedSalaryAmount        Decimal?               @db.Decimal(12, 2)
  hourlyRate               Decimal?               @db.Decimal(10, 2)
  serviceCommissionPercent Decimal?               @db.Decimal(5, 2)
  productCommissionPercent Decimal?               @db.Decimal(5, 2)
  salaryMode               CompensationSalaryMode @default(GUARANTEED_MINIMUM)
  note                     String?                @db.VarChar(1000)
  createdAt                DateTime               @default(now())

  business     Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        Staff                          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceRates StaffCompensationServiceRate[]
  earnings     StaffEarning[]

  @@unique([staffId, effectiveFrom])
  @@index([businessId])
  @@index([staffId, effectiveFrom, effectiveTo])
}

model StaffCompensationServiceRate {
  id                String  @id @default(uuid())
  planId            String
  serviceId         String
  commissionPercent Decimal @db.Decimal(5, 2)

  plan    StaffCompensationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceId])
  @@index([planId])
  @@index([serviceId])
}

model StaffEarning {
  id                      String             @id @default(uuid())
  businessId              String
  staffId                 String
  type                    StaffEarningType
  source                  StaffEarningSource
  earnedOn                DateTime           @db.Date
  amount                  Decimal            @db.Decimal(12, 2)
  currency                String             @db.VarChar(3)
  baseAmount              Decimal?           @db.Decimal(12, 2)
  ratePercent             Decimal?           @db.Decimal(5, 2)
  rateAmount              Decimal?           @db.Decimal(10, 2)
  quantity                Decimal?           @db.Decimal(10, 2)
  description             String?            @db.VarChar(500)
  reason                  String?            @db.VarChar(1000)
  actorId                 String?
  actorName               String?            @db.VarChar(300)
  idempotencyKey          String
  compensationPlanId      String?
  bookingId               String?
  bookingItemId           String?
  shiftId                 String?
  externalId              String?            @db.VarChar(100)
  reversesEarningId       String?            @unique
  correctsPayrollResultId String?
  payrollResultId         String?
  createdAt               DateTime           @default(now())

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff                 Staff                  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  compensationPlan      StaffCompensationPlan? @relation(fields: [compensationPlanId], references: [id], onDelete: SetNull)
  booking               Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingItem           BookingItem?           @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  shift                 StaffShift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reversesEarning       StaffEarning?          @relation("EarningReversal", fields: [reversesEarningId], references: [id])
  reversedBy            StaffEarning?          @relation("EarningReversal")
  correctsPayrollResult PayrollResult?         @relation("PayrollCorrections", fields: [correctsPayrollResultId], references: [id], onDelete: SetNull)
  payrollResult         PayrollResult?         @relation("PayrollResultEarnings", fields: [payrollResultId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, staffId, earnedOn])
  @@index([businessId, earnedOn])
  @@index([bookingId])
  @@index([bookingItemId])
  @@index([shiftId])
  @@index([payrollResultId])
}

model PayrollPeriod {
  id             String              @id @default(uuid())
  businessId     String
  name           String?             @db.VarChar(255)
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  currency       String              @db.VarChar(3)
  status         PayrollPeriodStatus @default(DRAFT)
  calculatedAt   DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?
  approvedById   String?
  approvedByName String?             @db.VarChar(300)
  paidById       String?
  paidByName     String?             @db.VarChar(300)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  results  PayrollResult[]

  @@unique([businessId, startDate, endDate])
  @@index([businessId, status])
}

model PayrollResult {
  id                      String               @id @default(uuid())
  periodId                String
  businessId              String
  staffId                 String
  staffName               String               @db.VarChar(250)
  roleTitle               String?              @db.VarChar(250)
  taxId                   String?              @db.VarChar(20)
  employeeNumber          String?              @db.VarChar(30)
  employmentType          StaffEmploymentType?
  payoutMethod            StaffPayoutMethod?
  payoutNote              String?              @db.VarChar(250)
  currency                String               @db.VarChar(3)
  fixedSalaryTotal        Decimal              @db.Decimal(12, 2)
  hourlyTotal             Decimal              @db.Decimal(12, 2)
  serviceCommissionTotal  Decimal              @db.Decimal(12, 2)
  productCommissionTotal  Decimal              @db.Decimal(12, 2)
  bonusTotal              Decimal              @db.Decimal(12, 2)
  deductionTotal          Decimal              @db.Decimal(12, 2)
  correctionTotal         Decimal              @db.Decimal(12, 2)
  totalAmount             Decimal              @db.Decimal(12, 2)
  earningsCount           Int
  createdAt               DateTime             @default(now())

  period      PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  earnings    StaffEarning[] @relation("PayrollResultEarnings")
  corrections StaffEarning[] @relation("PayrollCorrections")

  @@unique([periodId, staffId])
  @@index([businessId])
  @@index([staffId])
}
