generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CalendarEventType {
  BLOCK
  BOOKING
  INTEGRATION
}

enum CalendarEventRepeatType {
  NONE
  WEEKLY
}

enum BookingVisibility {
  PUBLIC
  PRIVATE
}

enum BusinessType {
  BARBERSHOP
  HAIR_SALON
  NAIL_SALON
  BEAUTY_SALON
  SPA
  MASSAGE
  COSMETOLOGY
  TATTOO_PIERCING
  BROWS_LASHES
  MEDICAL_CLINIC
  FITNESS
  YOGA_STUDIO
  AUTO_SERVICE
  PET_GROOMING
  EDUCATION
  PHOTO_STUDIO
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CancelledBy {
  CLIENT
  STAFF
}

enum BookingSource {
  PUBLIC_PAGE
  WIDGET
  MANUAL
  WALK_IN
}

enum BookingExecutionMode {
  SEQUENTIAL
  PARALLEL
}

enum BundlePricingMode {
  SUM
  FIXED
}

enum BookingChannelStatus {
  DRAFT
  PUBLISHED
}

enum BookingPalette {
  INK
  SAND
  SAGE
  DUSK
  WINE
  PEARL
  GRAPHITE
  EMERALD
  SKY
  LAVENDER
  CORAL
  MONO
  CUSTOM
}

enum BookingWidgetPlacement {
  INLINE
  SIDEBAR
  DIALOG
}

enum BookingWidgetTrigger {
  INLINE_BUTTON
  FLOATING_BUTTON
}

enum BookingWidgetButtonPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum AuditEntity {
  BOOKING
  BRAND
  CLIENT
  LOCATION
  STAFF
  SERVICE
  PAYROLL
  PRODUCT
  INVENTORY
  ORDER
}

enum AuditEvent {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_DEACTIVATED
  STAFF_DELETED
  STAFF_COMPENSATION_UPDATED
  STAFF_EARNING_ADDED
  STAFF_EARNING_REVERSED
  STAFF_SHIFTS_UPDATED
  STAFF_BLOCK_CREATED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED
  SERVICE_CATEGORY_CREATED
  SERVICE_CATEGORY_UPDATED
  SERVICE_CATEGORY_DELETED
  SERVICE_BUNDLE_CREATED
  SERVICE_BUNDLE_UPDATED
  SERVICE_BUNDLE_DELETED
  BRAND_UPDATED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_DELETED
  PAYROLL_PERIOD_CREATED
  PAYROLL_PERIOD_DELETED
  PAYROLL_CALCULATED
  PAYROLL_APPROVED
  PAYROLL_PAID
  PAYROLL_CORRECTED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  PRODUCT_CATEGORY_CREATED
  PRODUCT_CATEGORY_UPDATED
  PRODUCT_CATEGORY_DELETED
  PRODUCT_LOCATION_UPDATED
  INVENTORY_DOCUMENT_CREATED
  INVENTORY_DOCUMENT_UPDATED
  INVENTORY_DOCUMENT_POSTED
  INVENTORY_DOCUMENT_VOIDED
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_ITEM_CONFIRMED
  ORDER_ITEM_REVERSED
  ORDER_VOIDED
  ORDER_DELETED
}

enum AuditActorRole {
  CLIENT
  STAFF
  OWNER
  SUPPORT
  SYSTEM
  INTEGRATION
}

enum AuditActionType {
  CREATE
  MODIFY
  DELETE
  ACTION
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum InventoryDocumentType {
  RECEIPT
  WRITE_OFF
  ADJUSTMENT
  STOCKTAKE
  TRANSFER
}

enum InventoryDocumentStatus {
  OPEN
  POSTED
  VOIDED
}

enum InventoryMovementType {
  RECEIPT
  WRITE_OFF
  ADJUSTMENT
  STOCKTAKE
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_REVERSAL
  REVERSAL
}

enum OrderStatus {
  ACTIVE
  VOIDED
}

enum OrderItemType {
  PRODUCT
  SERVICE
  BUNDLE
  CUSTOM
}

enum OrderItemStatus {
  DRAFT
  CONFIRMED
  REVERSED
}

enum StaffEarningType {
  SERVICE_COMMISSION
  PRODUCT_COMMISSION
  HOURLY
  FIXED_SALARY
  BONUS
  DEDUCTION
  CORRECTION
}

enum StaffEarningSource {
  BOOKING
  SHIFT
  PRODUCT_SALE
  MANUAL
  PAYROLL
  IMPORT
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum StaffEmploymentType {
  LABOR_CONTRACT
  CIVIL_CONTRACT
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
}

enum StaffPayoutMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum CompensationSalaryMode {
  ADDITIVE
  GUARANTEED_MINIMUM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                       String               @id @default(uuid())
  role                     UserRole             @default(USER)
  firstName                String?              @db.VarChar(100)
  lastName                 String?              @db.VarChar(100)
  phone                    String?              @unique @db.VarChar(30)
  email                    String?              @unique @db.VarChar(254)
  passwordHash             String?
  phoneVerifiedAt          DateTime?
  emailVerifiedAt          DateTime?
  isMarketingEmailsEnabled Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  refreshTokens            RefreshToken[]
  passwordResetCode        PasswordResetCode?
  brandMemberships         BrandMembership[]
  locationMemberships      LocationMembership[]
  clients                  Client[]
  staffProfiles            Staff[]
  files                    File[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  expiryDate DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiryDate])
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  codeHash  String   @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id                String            @id @default(uuid())
  name              String            @db.VarChar(255)
  logoFileId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  logoFile          File?             @relation(fields: [logoFileId], references: [id], onDelete: SetNull)
  brandMemberships  BrandMembership[]
  clients           Client[]
  locations         Location[]
  productCategories ProductCategory[]
  products          Product[]
}

model Location {
  id                            String            @id @default(uuid())
  brandId                       String
  name                          String            @db.VarChar(255)
  countryCode                   String            @db.VarChar(2)
  currency                      String            @db.VarChar(3)
  timezone                      String            @db.VarChar(64)
  businessType                  BusinessType?
  city                          String?           @db.VarChar(120)
  addressLine                   String?           @db.VarChar(255)
  advanceBookingWindowDays      Int               @default(60)
  slotIntervalMinutes           Int               @default(30)
  minimumBookingNoticeMinutes   Int               @default(0)
  bookingVisibility             BookingVisibility @default(PUBLIC)
  isBookingConfirmationRequired Boolean           @default(false)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  brand                      Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locationMemberships        LocationMembership[]
  serviceCategories          ServiceCategory[]
  services                   Service[]
  staff                      Staff[]
  staffInvitations           StaffInvitation[]
  calendarEvents             CalendarEvent[]
  bookings                   Booking[]
  compensationPlans          StaffCompensationPlan[]
  staffEarnings              StaffEarning[]
  payrollPeriods             PayrollPeriod[]
  payrollResults             PayrollResult[]
  bookingPages               BookingPage[]
  bookingWidgets             BookingWidget[]
  serviceBundles             ServiceBundle[]
  bookingItems               BookingItem[]
  productLocations           ProductLocation[]
  inventoryDocuments         InventoryDocument[]     @relation("InventoryDocumentSource")
  incomingInventoryTransfers InventoryDocument[]     @relation("InventoryDocumentDestination")
  inventoryMovements         InventoryMovement[]
  orders                     Order[]

  @@index([brandId])
}

model ProductCategory {
  id          String   @id @default(uuid())
  brandId     String
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([brandId, name])
  @@index([brandId, sortOrder])
}

model Product {
  id          String        @id @default(uuid())
  brandId     String
  categoryId  String?
  imageFileId String?
  name        String        @db.VarChar(150)
  description String?       @db.VarChar(2000)
  sku         String?       @db.VarChar(80)
  barcode     String?       @db.VarChar(80)
  unit        ProductUnit   @default(PIECE)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category  ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFile File?             @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  locations ProductLocation[]

  @@unique([brandId, sku])
  @@unique([brandId, barcode])
  @@index([brandId, status])
  @@index([categoryId])
}

model ProductLocation {
  id             String        @id @default(uuid())
  productId      String
  locationId     String
  retailPrice    Decimal       @db.Decimal(10, 2)
  status         ProductStatus @default(ACTIVE)
  trackInventory Boolean       @default(true)
  reorderLevel   Decimal       @default(0) @db.Decimal(14, 3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  location               Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventoryBalance       InventoryBalance?
  inventoryDocumentItems InventoryDocumentItem[]
  inventoryMovements     InventoryMovement[]
  orderItems             OrderItem[]

  @@unique([productId, locationId])
  @@index([locationId, status])
  @@index([locationId, trackInventory])
}

model InventoryBalance {
  id                String   @id @default(uuid())
  productLocationId String   @unique
  quantityOnHand    Decimal  @default(0) @db.Decimal(14, 3)
  averageUnitCost   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt

  productLocation ProductLocation @relation(fields: [productLocationId], references: [id], onDelete: Restrict)

  @@index([updatedAt])
}

model InventoryDocument {
  id                    String                  @id @default(uuid())
  locationId            String
  destinationLocationId String?
  type                  InventoryDocumentType
  status                InventoryDocumentStatus @default(OPEN)
  occurredAt            DateTime
  reference             String?                 @db.VarChar(100)
  supplierName          String?                 @db.VarChar(200)
  reason                String?                 @db.VarChar(500)
  note                  String?                 @db.VarChar(1000)
  createdById           String?
  createdByName         String                  @db.VarChar(300)
  postedAt              DateTime?
  voidedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  location            Location                @relation("InventoryDocumentSource", fields: [locationId], references: [id], onDelete: Restrict)
  destinationLocation Location?               @relation("InventoryDocumentDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items               InventoryDocumentItem[]
  movements           InventoryMovement[]

  @@index([locationId, occurredAt])
  @@index([locationId, status])
  @@index([destinationLocationId, occurredAt])
}

model InventoryDocumentItem {
  id                String      @id @default(uuid())
  documentId        String
  productLocationId String
  productId         String
  productName       String      @db.VarChar(150)
  productSku        String?     @db.VarChar(80)
  productUnit       ProductUnit
  quantity          Decimal     @db.Decimal(14, 3)
  unitCost          Decimal?    @db.Decimal(12, 2)
  createdAt         DateTime    @default(now())

  document        InventoryDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productLocation ProductLocation     @relation(fields: [productLocationId], references: [id], onDelete: Restrict)
  movements       InventoryMovement[]

  @@unique([documentId, productLocationId])
  @@index([productLocationId])
  @@index([productId])
}

model InventoryMovement {
  id                    String                @id @default(uuid())
  locationId            String
  productLocationId     String
  documentId            String?
  documentItemId        String?
  orderId               String?
  orderItemId           String?
  type                  InventoryMovementType
  productId             String
  productName           String                @db.VarChar(150)
  productSku            String?               @db.VarChar(80)
  quantityDelta         Decimal               @db.Decimal(14, 3)
  quantityBefore        Decimal               @db.Decimal(14, 3)
  quantityAfter         Decimal               @db.Decimal(14, 3)
  averageUnitCostBefore Decimal               @db.Decimal(12, 2)
  averageUnitCostAfter  Decimal               @db.Decimal(12, 2)
  unitCost              Decimal               @db.Decimal(12, 2)
  totalCost             Decimal               @db.Decimal(14, 2)
  occurredAt            DateTime
  idempotencyKey        String
  reversedMovementId    String?               @unique
  createdAt             DateTime              @default(now())

  location         Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productLocation  ProductLocation        @relation(fields: [productLocationId], references: [id], onDelete: Restrict)
  document         InventoryDocument?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentItem     InventoryDocumentItem? @relation(fields: [documentItemId], references: [id], onDelete: Restrict)
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  reversedMovement InventoryMovement?     @relation("InventoryMovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversedBy       InventoryMovement?     @relation("InventoryMovementReversal")

  @@unique([locationId, idempotencyKey])
  @@index([productLocationId, occurredAt])
  @@index([locationId, occurredAt])
  @@index([documentId])
  @@index([orderId])
  @@index([orderItemId])
}

model Order {
  id              String      @id @default(uuid())
  locationId      String
  bookingId       String?     @unique
  clientId        String?
  clientName      String?     @db.VarChar(201)
  clientPhone     String?     @db.VarChar(30)
  currency        String      @db.VarChar(3)
  status          OrderStatus @default(ACTIVE)
  occurredAt      DateTime
  listTotalAmount Decimal     @default(0) @db.Decimal(12, 2)
  subtotalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  note            String?     @db.VarChar(1000)
  idempotencyKey  String?
  createdById     String?
  createdByName   String      @db.VarChar(300)
  voidedAt        DateTime?
  voidReason      String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  location  Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  booking   Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client    Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  movements InventoryMovement[]
  earnings  StaffEarning[]

  @@unique([locationId, idempotencyKey])
  @@index([locationId, occurredAt])
  @@index([locationId, status])
  @@index([clientId, occurredAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  type              OrderItemType
  bookingItemId     String?
  status            OrderItemStatus @default(DRAFT)
  catalogItemId     String?
  categoryId        String?
  productLocationId String?
  title             String          @db.VarChar(150)
  sku               String?         @db.VarChar(80)
  unit              ProductUnit?
  quantity          Decimal         @db.Decimal(14, 3)
  listUnitPrice     Decimal         @db.Decimal(10, 2)
  customUnitPrice   Decimal?        @db.Decimal(10, 2)
  unitPrice         Decimal         @db.Decimal(10, 2)
  lineSubtotal      Decimal         @db.Decimal(12, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)
  unitCostSnapshot  Decimal?        @db.Decimal(12, 2)
  lineCostSnapshot  Decimal?        @db.Decimal(14, 2)
  sellerStaffId     String?
  sellerName        String?         @db.VarChar(250)
  confirmedAt       DateTime?
  occurredAt        DateTime?
  createdAt         DateTime        @default(now())

  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookingItem     BookingItem?        @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  productLocation ProductLocation?    @relation(fields: [productLocationId], references: [id], onDelete: Restrict)
  seller          Staff?              @relation(fields: [sellerStaffId], references: [id], onDelete: SetNull)
  movements       InventoryMovement[]
  earnings        StaffEarning[]

  @@index([orderId])
  @@index([bookingItemId])
  @@index([productLocationId])
  @@index([sellerStaffId])
  @@index([type, catalogItemId])
  @@index([type, categoryId])
  @@index([status, occurredAt])
}

model BrandMembership {
  id        String       @id @default(uuid())
  userId    String
  brandId   String
  role      BusinessRole
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
}

model LocationMembership {
  id         String       @id @default(uuid())
  userId     String
  locationId String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
}

model Client {
  id      String  @id @default(uuid())
  brandId String
  userId  String?

  firstName String    @db.VarChar(100)
  lastName  String    @db.VarChar(100)
  phone     String    @db.VarChar(30)
  email     String?   @db.VarChar(254)
  birthDate DateTime? @db.Date
  gender    String?   @db.VarChar(20)
  notes     String?   @db.VarChar(1000)
  bannedAt  DateTime?
  banReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]
  orders   Order[]

  @@unique([brandId, phone])
  @@index([brandId])
  @@index([userId])
}

model ServiceCategory {
  id          String   @id @default(uuid())
  locationId  String
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  services Service[]
  bundles  ServiceBundle[]

  @@unique([locationId, name])
  @@index([locationId])
}

model Service {
  id              String        @id @default(uuid())
  locationId      String
  categoryId      String?
  imageFileId     String?
  title           String        @db.VarChar(150)
  description     String?       @db.VarChar(2000)
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int
  bufferMinutes   Int           @default(0)
  status          ServiceStatus @default(ACTIVE)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  location        Location                       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category        ServiceCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFile       File?                          @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  staffServices   StaffService[]
  bookingItems    BookingItem[]
  bundleItems     ServiceBundleItem[]
  commissionRates StaffCompensationServiceRate[]

  @@index([locationId])
  @@index([categoryId])
}

model ServiceBundle {
  id            String               @id @default(uuid())
  locationId    String
  categoryId    String?
  imageFileId   String?
  title         String               @db.VarChar(150)
  description   String?              @db.VarChar(2000)
  executionMode BookingExecutionMode @default(SEQUENTIAL)
  pricingMode   BundlePricingMode    @default(SUM)
  fixedPrice    Decimal?             @db.Decimal(10, 2)
  status        ServiceStatus        @default(ACTIVE)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  location  Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category  ServiceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFile File?               @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  items     ServiceBundleItem[]
  bookings  Booking[]

  @@index([locationId])
  @@index([categoryId])
}

model ServiceBundleItem {
  id        String @id @default(uuid())
  bundleId  String
  serviceId String
  sortOrder Int    @default(0)

  bundle  ServiceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bundleId, serviceId])
  @@index([bundleId])
  @@index([serviceId])
}

model Staff {
  id             String               @id @default(uuid())
  locationId     String
  userId         String?
  avatarFileId   String?
  name           String               @db.VarChar(250)
  phone          String?              @db.VarChar(30)
  email          String?              @db.VarChar(254)
  roleTitle      String?              @db.VarChar(250)
  description    String?              @db.VarChar(2000)
  status         StaffStatus          @default(ACTIVE)
  employmentType StaffEmploymentType?
  taxId          String?              @db.VarChar(20)
  employeeNumber String?              @db.VarChar(30)
  payoutMethod   StaffPayoutMethod?
  payoutNote     String?              @db.VarChar(250)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  location          Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  avatarFile        File?                   @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  staffServices     StaffService[]
  invitations       StaffInvitation[]
  shifts            StaffShift[]
  calendarEvents    CalendarEvent[]
  bookingItems      BookingItem[]
  compensationPlans StaffCompensationPlan[]
  earnings          StaffEarning[]
  payrollResults    PayrollResult[]
  soldOrderItems    OrderItem[]

  @@index([locationId])
}

model File {
  id            String   @id @default(uuid())
  userId        String
  url           String   @db.VarChar(1000)
  storageKey    String   @db.VarChar(500)
  fileName      String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffAvatars        Staff[]
  brandLogos          Brand[]
  serviceImages       Service[]
  serviceBundleImages ServiceBundle[]
  productImages       Product[]
  bookingPageCovers   BookingPage[]

  @@index([userId])
}

model StaffInvitation {
  id         String                @id @default(uuid())
  staffId    String
  locationId String
  tokenHash  String                @unique @db.VarChar(255)
  status     StaffInvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([locationId])
  @@index([status])
  @@index([expiresAt])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffShift {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  earnings StaffEarning[]

  @@unique([staffId, date])
  @@index([staffId, date])
}

model CalendarEvent {
  id            String                  @id @default(uuid())
  locationId    String
  staffId       String?
  type          CalendarEventType       @default(BLOCK)
  reason        String?                 @db.VarChar(100)
  title         String?                 @db.VarChar(255)
  notes         String?                 @db.VarChar(1000)
  repeatType    CalendarEventRepeatType @default(NONE)
  startDateTime DateTime
  endDateTime   DateTime
  daysMask      String?                 @db.VarChar(7)
  repeatUntil   DateTime?               @db.Date
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  location             Location                           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff                Staff?                             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cancelledOccurrences CalendarEventCancelledOccurrence[]
  bookingItem          BookingItem?

  @@index([locationId])
  @@index([locationId, staffId])
  @@index([locationId, repeatType, startDateTime])
}

model CalendarEventCancelledOccurrence {
  id             String   @id @default(uuid())
  eventId        String
  occurrenceDate DateTime @db.Date
  createdAt      DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
}

model Booking {
  id String @id @default(uuid())

  locationId String
  clientId   String

  startAt       DateTime
  endAt         DateTime
  executionMode BookingExecutionMode @default(SEQUENTIAL)
  bundleId      String?

  status BookingStatus @default(CONFIRMED)
  source BookingSource

  bookingPageId   String?
  bookingWidgetId String?

  clientFirstName String  @db.VarChar(100)
  clientLastName  String  @db.VarChar(100)
  clientPhone     String  @db.VarChar(30)
  clientEmail     String? @db.VarChar(254)

  notes         String? @db.VarChar(1000)
  internalNotes String? @db.VarChar(2000)

  cancellationReason String?      @db.VarChar(1000)
  cancelledBy        CancelledBy?
  cancelledAt        DateTime?

  reminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  bundle        ServiceBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  earnings      StaffEarning[]
  bookingPage   BookingPage?   @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  bookingWidget BookingWidget? @relation(fields: [bookingWidgetId], references: [id], onDelete: SetNull)
  orders        Order[]

  @@index([locationId, deletedAt, startAt])
  @@index([clientId, deletedAt, startAt])
  @@index([status])
  @@index([bundleId])
  @@index([bookingPageId])
  @@index([bookingWidgetId])
}

model BookingItem {
  id              String   @id @default(uuid())
  bookingId       String
  locationId      String
  serviceId       String
  staffId         String
  sortOrder       Int      @default(0)
  startAt         DateTime
  endAt           DateTime
  serviceTitle    String   @db.VarChar(150)
  serviceDuration Int
  listPrice       Decimal  @db.Decimal(10, 2)
  chargedPrice    Decimal  @db.Decimal(10, 2)
  customPrice     Decimal? @db.Decimal(10, 2)
  staffName       String   @db.VarChar(250)
  calendarEventId String?  @unique

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  earnings      StaffEarning[]
  orderItems    OrderItem[]

  @@index([bookingId])
  @@index([locationId])
  @@index([staffId, startAt])
  @@index([serviceId])
}

model BookingPage {
  id              String               @id @default(uuid())
  locationId      String
  title           String               @db.VarChar(80)
  slug            String               @unique @db.VarChar(48)
  status          BookingChannelStatus @default(DRAFT)
  tagline         String               @default("") @db.VarChar(120)
  html            String               @default("") @db.VarChar(20000)
  metaTitle       String               @default("") @db.VarChar(70)
  metaDescription String               @default("") @db.VarChar(160)
  coverFileId     String?

  palette           BookingPalette
  customBackground  String?        @db.VarChar(7)
  customSurface     String?        @db.VarChar(7)
  customText        String?        @db.VarChar(7)
  customMuted       String?        @db.VarChar(7)
  customAccent      String?        @db.VarChar(7)
  customAccentText  String?        @db.VarChar(7)
  headline          String         @db.VarChar(80)
  caption           String         @default("") @db.VarChar(120)
  buttonLabel       String         @db.VarChar(32)
  showStaff         Boolean
  showServiceImages Boolean
  showBranding      Boolean

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  coverFile File?     @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  bookings  Booking[]

  @@index([locationId, updatedAt])
}

model BookingWidget {
  id             String                      @id @default(uuid())
  locationId     String
  title          String                      @db.VarChar(80)
  titleKey       String                      @db.VarChar(80)
  status         BookingChannelStatus        @default(DRAFT)
  placement      BookingWidgetPlacement
  trigger        BookingWidgetTrigger
  buttonPosition BookingWidgetButtonPosition
  allowedDomains String[]                    @default([])

  palette           BookingPalette
  customBackground  String?        @db.VarChar(7)
  customSurface     String?        @db.VarChar(7)
  customText        String?        @db.VarChar(7)
  customMuted       String?        @db.VarChar(7)
  customAccent      String?        @db.VarChar(7)
  customAccentText  String?        @db.VarChar(7)
  headline          String         @db.VarChar(80)
  caption           String         @default("") @db.VarChar(120)
  buttonLabel       String         @db.VarChar(32)
  showStaff         Boolean
  showServiceImages Boolean
  showBranding      Boolean

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([locationId, titleKey])
  @@index([locationId, updatedAt])
}

model AuditLog {
  id         String          @id @default(uuid())
  brandId    String
  locationId String?
  entityType AuditEntity
  entityId   String
  eventType  AuditEvent
  actionType AuditActionType
  occurredAt DateTime
  actorId    String?
  actorName  String          @db.VarChar(300)
  actorRole  AuditActorRole
  payload    Json
  createdAt  DateTime        @default(now())

  @@index([brandId, entityType, entityId])
  @@index([brandId, entityType, entityId, createdAt])
  @@index([locationId, entityType, entityId])
  @@index([locationId, entityType, entityId, createdAt])
}

model StaffCompensationPlan {
  id                       String                 @id @default(uuid())
  locationId               String
  staffId                  String
  effectiveFrom            DateTime               @db.Date
  effectiveTo              DateTime?              @db.Date
  fixedSalaryAmount        Decimal?               @db.Decimal(12, 2)
  hourlyRate               Decimal?               @db.Decimal(10, 2)
  serviceCommissionPercent Decimal?               @db.Decimal(5, 2)
  productCommissionPercent Decimal?               @db.Decimal(5, 2)
  salaryMode               CompensationSalaryMode @default(GUARANTEED_MINIMUM)
  note                     String?                @db.VarChar(1000)
  createdAt                DateTime               @default(now())

  location     Location                       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff        Staff                          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceRates StaffCompensationServiceRate[]
  earnings     StaffEarning[]

  @@unique([staffId, effectiveFrom])
  @@index([locationId])
  @@index([staffId, effectiveFrom, effectiveTo])
}

model StaffCompensationServiceRate {
  id                String  @id @default(uuid())
  planId            String
  serviceId         String
  commissionPercent Decimal @db.Decimal(5, 2)

  plan    StaffCompensationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceId])
  @@index([planId])
  @@index([serviceId])
}

model StaffEarning {
  id                      String             @id @default(uuid())
  locationId              String
  staffId                 String
  type                    StaffEarningType
  source                  StaffEarningSource
  earnedOn                DateTime           @db.Date
  amount                  Decimal            @db.Decimal(12, 2)
  currency                String             @db.VarChar(3)
  baseAmount              Decimal?           @db.Decimal(12, 2)
  ratePercent             Decimal?           @db.Decimal(5, 2)
  rateAmount              Decimal?           @db.Decimal(10, 2)
  quantity                Decimal?           @db.Decimal(10, 2)
  description             String?            @db.VarChar(500)
  reason                  String?            @db.VarChar(1000)
  actorId                 String?
  actorName               String?            @db.VarChar(300)
  idempotencyKey          String
  compensationPlanId      String?
  bookingId               String?
  bookingItemId           String?
  shiftId                 String?
  orderId                 String?
  orderItemId             String?
  externalId              String?            @db.VarChar(100)
  reversesEarningId       String?            @unique
  correctsPayrollResultId String?
  payrollResultId         String?
  createdAt               DateTime           @default(now())

  location              Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff                 Staff                  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  compensationPlan      StaffCompensationPlan? @relation(fields: [compensationPlanId], references: [id], onDelete: SetNull)
  booking               Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingItem           BookingItem?           @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  shift                 StaffShift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem             OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  reversesEarning       StaffEarning?          @relation("EarningReversal", fields: [reversesEarningId], references: [id])
  reversedBy            StaffEarning?          @relation("EarningReversal")
  correctsPayrollResult PayrollResult?         @relation("PayrollCorrections", fields: [correctsPayrollResultId], references: [id], onDelete: SetNull)
  payrollResult         PayrollResult?         @relation("PayrollResultEarnings", fields: [payrollResultId], references: [id], onDelete: SetNull)

  @@unique([locationId, idempotencyKey])
  @@index([locationId, staffId, earnedOn])
  @@index([locationId, earnedOn])
  @@index([bookingId])
  @@index([bookingItemId])
  @@index([shiftId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([payrollResultId])
}

model PayrollPeriod {
  id             String              @id @default(uuid())
  locationId     String
  name           String?             @db.VarChar(255)
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  currency       String              @db.VarChar(3)
  status         PayrollPeriodStatus @default(DRAFT)
  calculatedAt   DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?
  approvedById   String?
  approvedByName String?             @db.VarChar(300)
  paidById       String?
  paidByName     String?             @db.VarChar(300)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  results  PayrollResult[]

  @@unique([locationId, startDate, endDate])
  @@index([locationId, status])
}

model PayrollResult {
  id                     String               @id @default(uuid())
  periodId               String
  locationId             String
  staffId                String
  staffName              String               @db.VarChar(250)
  roleTitle              String?              @db.VarChar(250)
  taxId                  String?              @db.VarChar(20)
  employeeNumber         String?              @db.VarChar(30)
  employmentType         StaffEmploymentType?
  payoutMethod           StaffPayoutMethod?
  payoutNote             String?              @db.VarChar(250)
  currency               String               @db.VarChar(3)
  fixedSalaryTotal       Decimal              @db.Decimal(12, 2)
  hourlyTotal            Decimal              @db.Decimal(12, 2)
  serviceCommissionTotal Decimal              @db.Decimal(12, 2)
  productCommissionTotal Decimal              @db.Decimal(12, 2)
  bonusTotal             Decimal              @db.Decimal(12, 2)
  deductionTotal         Decimal              @db.Decimal(12, 2)
  correctionTotal        Decimal              @db.Decimal(12, 2)
  totalAmount            Decimal              @db.Decimal(12, 2)
  earningsCount          Int
  createdAt              DateTime             @default(now())

  period      PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  location    Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff       Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  earnings    StaffEarning[] @relation("PayrollResultEarnings")
  corrections StaffEarning[] @relation("PayrollCorrections")

  @@unique([periodId, staffId])
  @@index([locationId])
  @@index([staffId])
}
