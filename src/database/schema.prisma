generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum BusinessRole {
  OWNER
  STAFF
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CalendarEventType {
  BLOCK
}

enum CalendarEventRepeatType {
  NONE
  WEEKLY
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                       String         @id @default(uuid())
  role                     UserRole       @default(USER)
  firstName                String?        @db.VarChar(100)
  lastName                 String?        @db.VarChar(100)
  phone                    String?        @unique @db.VarChar(30)
  email                    String?        @unique @db.VarChar(254)
  passwordHash             String?
  phoneVerifiedAt          DateTime?
  emailVerifiedAt          DateTime?
  isMarketingEmailsEnabled Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  refreshTokens            RefreshToken[]
  memberships              Membership[]
  clients                  Client[]
  staffProfiles            Staff[]
  files                    File[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique @db.VarChar(512)
  userAgent  String?  @db.VarChar(512)
  expiryDate DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                            String              @id @default(uuid())
  name                          String              @db.VarChar(255)
  logoFileId                    String?
  advanceBookingWindowDays      Int                 @default(15)
  slotIntervalMinutes           Int                 @default(30)
  minimumBookingNoticeMinutes   Int                 @default(0)
  timezone                      String              @default("UTC") @db.VarChar(64)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  logoFile                      File?               @relation(fields: [logoFileId], references: [id], onDelete: SetNull)
  memberships                   Membership[]
  clients                       Client[]
  serviceCategories             ServiceCategory[]
  services                      Service[]
  staff                         Staff[]
  staffInvitations              StaffInvitation[]
  calendarEvents                CalendarEvent[]
}

model Membership {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model Client {
  id         String   @id @default(uuid())
  businessId String
  userId     String?

  firstName  String    @db.VarChar(100)
  lastName   String    @db.VarChar(100)
  phone      String    @db.VarChar(30)
  email      String?   @db.VarChar(254)
  birthDate  DateTime? @db.Date
  gender     String?   @db.VarChar(20)
  notes      String?   @db.VarChar(1000)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([userId])
}

model ServiceCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String   @db.VarChar(255)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Service {
  id              String   @id @default(uuid())
  businessId      String
  categoryId      String?
  title           String   @db.VarChar(150)
  description     String?  @db.VarChar(2000)
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffServices StaffService[]

  @@index([businessId])
  @@index([categoryId])
}

model Staff {
  id           String   @id @default(uuid())
  businessId   String
  userId       String?
  avatarFileId String?
  name         String   @db.VarChar(250)
  roleTitle    String?  @db.VarChar(250)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  avatarFile    File?             @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  staffServices StaffService[]
  invitations   StaffInvitation[]
  shifts        StaffShift[]
  calendarEvents CalendarEvent[]

  @@index([businessId])
}

model File {
  id            String   @id @default(uuid())
  userId        String
  url           String   @db.VarChar(1000)
  storageKey    String   @db.VarChar(500)
  fileName      String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffAvatars   Staff[]
  businessLogos  Business[]

  @@index([userId])
}

model StaffInvitation {
  id         String                @id @default(uuid())
  staffId    String
  businessId String
  tokenHash  String                @unique @db.VarChar(255)
  status     StaffInvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([businessId])
  @@index([status])
  @@index([expiresAt])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffShift {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

model CalendarEvent {
  id            String                  @id @default(uuid())
  businessId    String
  staffId       String?
  type          CalendarEventType       @default(BLOCK)
  reason        String?                 @db.VarChar(100)
  title         String?                 @db.VarChar(255)
  notes         String?                 @db.VarChar(1000)
  repeatType    CalendarEventRepeatType @default(NONE)
  startDateTime DateTime
  endDateTime   DateTime
  daysMask      String?                 @db.VarChar(7)
  repeatUntil   DateTime?               @db.Date
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  business             Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff                Staff?                           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cancelledOccurrences CalendarEventCancelledOccurrence[]

  @@index([businessId])
  @@index([businessId, staffId])
  @@index([businessId, repeatType])
}

model CalendarEventCancelledOccurrence {
  id             String        @id @default(uuid())
  eventId        String
  occurrenceDate DateTime      @db.Date
  createdAt      DateTime      @default(now())

  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
}
