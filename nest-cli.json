{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "modules/audit/templates/**/*.hbs", "watchAssets": true },
      { "include": "modules/notifications/channels/email/templates/**/*.hbs", "watchAssets": true },
      { "include": "shared/i18n/*.json", "watchAssets": true }
    ]
  }
}
