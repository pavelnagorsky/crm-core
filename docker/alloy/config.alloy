// Collects stdout of every container of the klendo-core compose project and ships it to Loki.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=klendo-core"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Replicas share service="api": the container name ("klendo-core-api-3") tells them apart.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.logs.receiver]
}

loki.process "logs" {
  // Stack traces continue on lines that do not start with "[timestamp]": keep them in one entry.
  stage.match {
    selector = "{service=~\"api|worker\"}"

    stage.multiline {
      firstline     = "^\\[\\d{4}-\\d{2}-\\d{2} "
      max_wait_time = "3s"
    }
  }

  // "[2026-11-04 12:42:10.123 UTC] WARN: ..." -> level=WARN.
  // requestId is deliberately NOT a label (high cardinality): search it as text.
  stage.regex {
    expression = "^\\[[^\\]]+\\] (?P<level>[A-Z]+):"
  }

  stage.labels {
    values = { level = "" }
  }

  // Lines without a level (nginx access log, postgres, redis, ...).
  stage.match {
    selector = "{level=\"\"}"

    stage.static_labels {
      values = { level = "UNKNOWN" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
