    {
      "id": 8,
      "type": "timeseries",
      "title": "Соединения по состоянию",
      "description": "idle in transaction, которые долго держатся, — утечка транзакций.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count{datname!~\"template.*|postgres\"})",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
