          "expr": "sum(rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname!~\"template.*|postgres\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
