# App
PORT=3000
# Express `trust proxy`: hop count (e.g. 1) or comma-separated trusted proxies.
# Default: loopback, linklocal, uniquelocal (nginx on host or in Docker network).
# TRUST_PROXY=
APP_LOCALE=ru
LOG_LEVEL=info
# Local runs write logs to this directory. Compose containers log to stdout only (collected by Loki).
LOG_DIRECTORY=logs
DOMAIN=http://localhost:8083
ALLOWED_ORIGINS=https://example.com,http://localhost:8083,http://localhost:3001

# The cache lives in Redis (shared by replicas), or in process memory without REDIS_URL. Enabled by default.
# Set false for local profiling without caching.
CACHE_ENABLED=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/booking-crm
# Prisma connection pool per process (pg-boss adds 3 more), see docs/deployment.md.
DATABASE_POOL_SIZE=10

# Redis: cache, rate limits, cron locks shared by all processes. Required in production.
# Unset: the same features use in-memory stores (fully working, single process only).
# Locally: `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379
# api | worker | all. Crons run only in worker/all.
APP_ROLE=all
# Docker Compose only: Grafana admin password (user admin, http://127.0.0.1:3200). Required by the grafana
# container; reapplied on every start, so change it here and run `docker compose up -d grafana`.
GRAFANA_ADMIN_PASSWORD=change_me
# Docker Compose only: database address as seen from containers. Default: the local `postgres` service.
# On a server (no postgres service) set it to the external Postgres.
# DOCKER_DATABASE_URL=postgresql://user:password@host:5432/booking-crm
# Docker Compose on a server only: image repository in GHCR (ghcr.io/pavelnagorsky/crm-core). Unset: local
# build klendo-core:local. IMAGE_TAG (commit sha) is appended by scripts/deploy/deploy.sh.
# CORE_IMAGE=
# IMAGE_TAG=
# Docker Compose only: host port of the load balancer (127.0.0.1:APP_PORT).
# APP_PORT=3000

# Prometheus metrics (docs/metrics.md): an internal server, separate from the API port. 0 disables it.
# Default 127.0.0.1:9464; Docker Compose sets 0.0.0.0 so prometheus can reach it (the port is never published).
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# Docker Compose on the server only: postgres-exporter connection, a role with pg_monitor (docs/metrics.md).
# Default: the local `postgres` service.
# POSTGRES_EXPORTER_DSN=postgresql://monitor:password@host:5432/booking-crm?sslmode=disable

# Mailer
# SMTP_HOST=smtp.hoster.by
# SMTP_PORT=465
EMAIL=your_email@example.com
EMAIL_PW=your_email_password

# Notifications
# Enabled by default. Set to false on dev/stage to mute emails to business clients (bookings, reminders, reviews).
# Emails to CRM accounts (registration, password reset, invitations, staff and billing notices) are always sent.
CLIENT_NOTIFICATIONS_ENABLED=true

# JWT secrets
ACCESS_TOKEN_SECRET=your_secret
# Also derives the invitation-link encryption key; keep stable while invitations are active.
EMAIL_TOKEN_SECRET=your_secret
REFRESH_TOKEN_SECRET=your_secret
BOOKING_CLIENT_TOKEN_SECRET=your_secret

# Google Cloud
# Service account key: secrets/google-credentials.json (git-ignored) is used by default, and Docker Compose
# points containers to /run/secrets/google-credentials.json. Set only to use a key from another place.
# GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_BUCKET_NAME=your_google_bucket_name
GOOGLE_PRIVATE_BUCKET_NAME=your_private_google_bucket_name
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLOUD_CLIENT_ID=your_id_for_oauth
GOOGLE_CLOUD_CLIENT_SECRET=your_secret_for_oauth

# Yandex Cloud
YANDEX_API_KEY=your_yandex_api_key
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret

# VK
VK_CLIENT_ID=your_vk_client_id
VK_CODE_VERIFIER=your_vk_code_verifier

# API replicas behind lb (Docker Compose). Deploys replace them one batch at a time without downtime.
API_REPLICAS=2

# Daily database backups to a private GCS bucket (docs/backups.md). Server only.
# BACKUP_BUCKET=your-backup-bucket
# COMPOSE_PROFILES=backup
# BACKUP_CRON=30 3 * * *
# BACKUP_TZ=Europe/Minsk
