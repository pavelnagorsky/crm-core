# App
PORT=3000
APP_LOCALE=ru
DOMAIN=http://localhost:8083
ALLOWED_ORIGINS=https://example.com,http://localhost:8083,http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/booking-crm

# Mailer
EMAIL=your_email@example.com
EMAIL_PW=your_email_password

# Notifications
# Enabled by default. Set to false to mute all outgoing notifications (e.g. seeded/test runs).
NOTIFICATIONS_ENABLED=true

# JWT secrets
ACCESS_TOKEN_SECRET=your_secret
EMAIL_TOKEN_SECRET=your_secret
REFRESH_TOKEN_SECRET=your_secret
BOOKING_CLIENT_TOKEN_SECRET=your_secret

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./cloud-storage.json
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_BUCKET_NAME=your_google_bucket_name
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLOUD_CLIENT_ID=your_id_for_oauth
GOOGLE_CLOUD_CLIENT_SECRET=your_secret_for_oauth

# Yandex Cloud
YANDEX_API_KEY=your_yandex_api_key
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret

# VK
VK_CLIENT_ID=your_vk_client_id
VK_CODE_VERIFIER=your_vk_code_verifier
